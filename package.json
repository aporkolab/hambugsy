{
  "name": "hambugsy",
  "version": "1.0.2",
  "description": "The CLI tool that tells you WHO is wrong: your test or your code. Uses GitHub Copilot CLI for AI-powered test failure diagnosis.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hambugsy": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "testing",
    "test-failure",
    "diagnostics",
    "debugging",
    "github-copilot",
    "ai",
    "java",
    "junit",
    "jest",
    "vitest",
    "pytest",
    "go-test",
    "cargo-test",
    "nunit",
    "xunit",
    "mstest",
    "code-analysis",
    "developer-tools",
    "typescript",
    "python",
    "golang",
    "rust",
    "csharp"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": {
    "name": "Dr. Porkoláb Ádám",
    "email": "ap@aporkolab.com",
    "url": "https://hambugsy.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/APorkolab/hambugsy.git"
  },
  "homepage": "https://hambugsy.dev",
  "bugs": {
    "url": "https://github.com/APorkolab/hambugsy/issues"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "chokidar": "^6.0.0",
    "commander": "^15.0.0",
    "execa": "^10.2.1",
    "figlet": "^1.12.0",
    "glob": "^14.0.3",
    "ora": "^9.4.1",
    "p-queue": "^10.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/figlet": "^1.12.0",
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
